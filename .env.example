NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://codepet:codepet_dev_password@localhost:3306/codepet"
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# AI Provider choice:
# gemini | groq | siliconflow | deepseek | qwen | zhipu | moonshot | ollama | openai | none
AI_PROVIDER=gemini

# 1. Google Gemini (Free Tier: 15 RPM / 1M TPM - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Groq Cloud (100% Free Forever, 500+ tok/s - https://console.groq.com/keys)
# GROQ_API_KEY=

# 3. SiliconFlow (Free DeepSeek-R1 & Qwen 2.5 Coder Cloud - https://cloud.siliconflow.cn/account/ak)
# SILICONFLOW_API_KEY=

# 4. DeepSeek Official (Free trial credits - https://platform.deepseek.com/api_keys)
# DEEPSEEK_API_KEY=

# 5. Alibaba Qwen / DashScope (1M free tokens - https://bailian.console.aliyun.com/)
# QWEN_API_KEY=

# 6. Zhipu AI GLM (100% Free Public GLM-4-Flash - https://open.bigmodel.cn/usercenter/apikeys)
# ZHIPU_API_KEY=

# 7. Moonshot AI / Kimi (Free credits - https://platform.moonshot.cn/console/api-keys)
# MOONSHOT_API_KEY=

# 8. Ollama Local (100% Free & Offline, 0 API keys - https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# 9. OpenAI / ChatGPT (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model override (optional):
# AI_MODEL=
